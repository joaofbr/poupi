---
import Calendar from '../Calendar.astro'
import Phone from '../app/Phone.astro'
import AppHeader from '../app/AppHeader.astro'
import AppNav from '../app/AppNav.astro'
import MonthPill from '../app/MonthPill.astro'
import Summary from '../app/Summary.astro'
import { CLOSE_DAY, brl, byCategory, monthTotals } from '../../data/story'

const totals = monthTotals(CLOSE_DAY)
const slices = byCategory(CLOSE_DAY)
const gap = 1.4
let cursor = 0
const segments = slices.map((slice) => {
  const share = (slice.value / totals.expense) * 100
  const segment = { color: slice.color, start: cursor, length: Math.max(share - gap, 0.4) }
  cursor += share
  return segment
})
const top = slices[0]
---

<section class="scene scene-pinned scene-cal month-close" id="fechamento" aria-labelledby="close-title" data-scene="close">
  <div class="wrap scene-inner" data-root>
    <Calendar today={CLOSE_DAY} />
    <div class="story">
      <h2 class="sr-only-text" id="close-title">O mês fecha</h2>
      <div class="panel on" data-panel="a">
        <span class="kicker">Dias 18 a 27</span>
        <h3 class="display">O resto do mês, sem susto.</h3>
        <p>Luz, internet, feira e gasolina. Cada gasto entra em segundos, de qualquer celular da casa, e o saldo acompanha.</p>
      </div>
      <div class="panel" data-panel="b">
        <span class="kicker">Dia 30</span>
        <h3 class="display">O mês fecha. E as contas batem.</h3>
        <p>Entraram {brl(totals.income)}, saíram {brl(totals.expense)} e sobraram {brl(totals.balance)}. O gráfico mostra pra onde foi: {top.percent}% em {top.label.toLowerCase()}.</p>
      </div>
    </div>
    <div class="stage" data-el="stage">
      <Phone label={`Resumo de novembro no Poupi: receitas de ${brl(totals.income)}, despesas de ${brl(totals.expense)}, saldo de ${brl(totals.balance)}. ${slices.map((s) => `${s.label} ${s.percent}%`).join(', ')}`} data-el="phone">
        <AppHeader title="Dashboard" />
        <div class="a-body" data-el="body">
          <MonthPill />
          <Summary income={totals.income} expense={totals.expense} balance={totals.balance} />
          <div class="a-card a-donut" data-el="donut-card">
            <div class="a-donut-head">Gastos por categoria</div>
            <div class="a-donut-figure">
              <svg viewBox="0 0 42 42" aria-hidden="true">
                <circle cx="21" cy="21" r="15.915" fill="none" stroke="var(--a-chip)" stroke-width="4.5" />
                {segments.map((segment) => (
                  <circle
                    cx="21"
                    cy="21"
                    r="15.915"
                    fill="none"
                    stroke={segment.color}
                    stroke-width="4.5"
                    stroke-dasharray={`${segment.length} ${100 - segment.length}`}
                    stroke-dashoffset={`${-segment.start}`}
                    data-start={segment.start}
                    data-length={segment.length}
                  />
                ))}
              </svg>
              <div class="a-donut-center"><small>Total</small><b data-el="donut-total">{brl(totals.expense)}</b></div>
            </div>
            <div class="a-legend" data-el="legend">
              {slices.map((slice) => (
                <div><i style={`background:${slice.color}`}></i><span>{slice.label}</span><small>{slice.percent}%</small><b>{brl(slice.value)}</b></div>
              ))}
            </div>
          </div>
        </div>
        <AppNav active="inicio" />
      </Phone>
    </div>
  </div>
</section>
